  setting_key String   @db.VarChar(100) // e.g. DEFAULT_AR_ACCOUNT
  account_id  String   @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @updatedAt @db.Timestamp(6)

  company Company        @relation(fields: [company_id], references: [id], onDelete: NoAction)
  account ChartOfAccount @relation(fields: [account_id], references: [id], onDelete: NoAction)

  @@unique([company_id, setting_key])
  @@map("company_finance_settings")
  @@schema("auth")
}

model FinanceSequence {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id String @db.Uuid
  type       String @db.VarChar(50) // VOUCHER, INVOICE, etc
  prefix     String @db.VarChar(10)
  last_value Int    @default(0)

  @@unique([company_id, type])
  @@map("finance_sequences")
  @@schema("auth")
}

// ─── Week 9: VAT Engine ──────────────────────────────────────────────────────

model VATTransaction {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id     String   @db.Uuid
  document_type  String   @db.VarChar(30) // CLIENT_INVOICE | VENDOR_BILL | CREDIT_NOTE | DEBIT_NOTE
  document_id    String   @db.Uuid
  // STANDARD | ZERO_RATED | EXEMPT | REVERSE_CHARGE
  vat_type       String   @db.VarChar(30)
  // OUTPUT (sales) | INPUT (purchases)
  direction      String   @db.VarChar(10)
  line_index     Int      @default(0)
  taxable_amount Decimal  @db.Decimal
  vat_rate       Decimal  @db.Decimal
  vat_amount     Decimal  @db.Decimal
  period_id      String?  @db.Uuid
  tax_config_id  String?  @db.Uuid
  posting_date   DateTime @db.Date
  created_by     String   @db.Uuid
  created_at     DateTime @default(now()) @db.Timestamp(6)
  // Immutable — never update or delete

  company    Company           @relation(fields: [company_id], references: [id], onDelete: NoAction)
  tax_config TaxConfiguration? @relation(fields: [tax_config_id], references: [id], onDelete: NoAction)
  invoice    ClientInvoice?    @relation(fields: [document_id], references: [id], onDelete: NoAction, map: "vat_tx_invoice_fk")
  bill       VendorBill?       @relation(fields: [document_id], references: [id], onDelete: NoAction, map: "vat_tx_bill_fk")

  @@index([company_id, direction, posting_date])
  @@index([company_id, document_type, document_id])
  @@index([company_id, period_id])
  @@map("vat_transactions")
  @@schema("auth")
}

model VATReconciliationSnapshot {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id        String   @db.Uuid
  period_id         String   @db.Uuid
  period_month      String   @db.VarChar(7)
  output_vat_ledger Decimal  @db.Decimal
  output_vat_tx     Decimal  @db.Decimal
  input_vat_ledger  Decimal  @db.Decimal
  input_vat_tx      Decimal  @db.Decimal
  output_mismatch   Decimal  @db.Decimal
  input_mismatch    Decimal  @db.Decimal
  is_balanced       Boolean  @default(false)
  computed_at       DateTime @default(now()) @db.Timestamp(6)
  computed_by       String?  @db.Uuid

  company Company @relation(fields: [company_id], references: [id], onDelete: NoAction)

  @@index([company_id, period_id])
  @@map("vat_reconciliation_snapshots")
  @@schema("auth")
}

// ─── Week 9: ZATCA Submission Engine ─────────────────────────────────────────

model ZATCASubmission {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id     String    @db.Uuid
  invoice_id     String    @db.Uuid
  // DRAFT | QUEUED | SUBMITTED | ACCEPTED | REJECTED | CLEARED | FAILED | RETRYING
  status         String    @default("QUEUED") @db.VarChar(20)
  zatca_uuid     String?   @db.VarChar(100)
  invoice_hash   String?   @db.VarChar(256)
  qr_code_base64 String? // TLV base64
  xml_payload    String? // Full XML for Phase 2
  zatca_response Json? // Raw API response
  error_message  String?
  retry_count    Int       @default(0)
  next_retry_at  DateTime? @db.Timestamp(6)
  submitted_at   DateTime? @db.Timestamp(6)
  accepted_at    DateTime? @db.Timestamp(6)
  rejected_at    DateTime? @db.Timestamp(6)
  cleared_at     DateTime? @db.Timestamp(6)
  created_at     DateTime  @default(now()) @db.Timestamp(6)
  updated_at     DateTime  @updatedAt @db.Timestamp(6)

  company    Company         @relation(fields: [company_id], references: [id], onDelete: NoAction)
  invoice    ClientInvoice   @relation(fields: [invoice_id], references: [id], onDelete: NoAction)
  event_logs ZATCAEventLog[]

  @@index([company_id, status])
  @@index([company_id, invoice_id])
  @@index([status, next_retry_at])
  @@map("zatca_submissions")
  @@schema("auth")
}

model ZATCAEventLog {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id       String   @db.Uuid
  submission_id    String   @db.Uuid
  event_type       String   @db.VarChar(50) // QUEUED | SUBMITTED | ACCEPTED | REJECTED | RETRY | FAILED | SIMULATION
  status_before    String?  @db.VarChar(20)
  status_after     String   @db.VarChar(20)
  request_payload  Json?
  response_payload Json?
  error_details    String?
  retry_count      Int      @default(0)
  triggered_by     String?  @db.VarChar(50) // worker | manual | api
  created_at       DateTime @default(now()) @db.Timestamp(6)
  // Append-only — never update or delete

  company    Company         @relation(fields: [company_id], references: [id], onDelete: NoAction)
  submission ZATCASubmission @relation(fields: [submission_id], references: [id], onDelete: NoAction)

  @@index([company_id, submission_id])
  @@index([company_id, event_type, created_at])
  @@map("zatca_event_logs")
  @@schema("auth")
}

// ─── Week 9: Financial Audit Log ─────────────────────────────────────────────

model FinancialAuditLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id   String   @db.Uuid
  user_id      String?  @db.Uuid
  action       String   @db.VarChar(80) // INVOICE_POSTED | VAT_RECALCULATED | ZATCA_RETRY | etc.
  entity_type  String   @db.VarChar(50)
  entity_id    String   @db.VarChar(100)
  before_state Json?
  after_state  Json?
  meta         Json? // ip, request_id, device
  created_at   DateTime @default(now()) @db.Timestamp(6)
  // Append-only — never update or delete

  company Company @relation(fields: [company_id], references: [id], onDelete: NoAction)

  @@index([company_id, entity_type, entity_id])
  @@index([company_id, action, created_at])
  @@index([company_id, user_id])
  @@map("financial_audit_logs")
  @@schema("auth")
}

// ─── Week 9: Profitability Snapshots ─────────────────────────────────────────

model ProfitSnapshot {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id     String   @db.Uuid
  period_month   String   @db.VarChar(7) // e.g. "2025-05"
  total_revenue  Decimal  @default(0) @db.Decimal
  total_cogs     Decimal  @default(0) @db.Decimal
  gross_profit   Decimal  @default(0) @db.Decimal
  total_opex     Decimal  @default(0) @db.Decimal
  ebitda         Decimal  @default(0) @db.Decimal
  net_profit     Decimal  @default(0) @db.Decimal
  net_margin_pct Decimal  @default(0) @db.Decimal
  computed_at    DateTime @default(now()) @db.Timestamp(6)
  computed_by    String?  @db.VarChar(30) // worker | manual

  company Company @relation(fields: [company_id], references: [id], onDelete: NoAction)

  @@unique([company_id, period_month])
  @@index([company_id, period_month])
  @@map("profit_snapshots")
  @@schema("auth")
}

model ProjectProfitSnapshot {
