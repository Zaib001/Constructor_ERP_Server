model DepartmentProfitSnapshot {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id        String   @db.Uuid
  department_id     String   @db.Uuid
  period_month      String   @db.VarChar(7)
  revenue_allocated Decimal  @default(0) @db.Decimal
  salary_costs      Decimal  @default(0) @db.Decimal
  expense_costs     Decimal  @default(0) @db.Decimal
  overhead_costs    Decimal  @default(0) @db.Decimal
  net_profit        Decimal  @default(0) @db.Decimal
  margin_pct        Decimal  @default(0) @db.Decimal
  computed_at       DateTime @default(now()) @db.Timestamp(6)

  company    Company    @relation(fields: [company_id], references: [id], onDelete: NoAction)
  department Department @relation(fields: [department_id], references: [id], onDelete: NoAction)

  @@unique([company_id, department_id, period_month])
  @@index([company_id, period_month])
  @@map("department_profit_snapshots")
  @@schema("auth")
}

model RecalculationQueue {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id   String    @db.Uuid
  queue_type   String    @db.VarChar(30) // PROFITABILITY | VAT_RECONCILE
  period_month String?   @db.VarChar(7)
  status       String    @default("PENDING") @db.VarChar(20) // PENDING | PROCESSING | DONE | FAILED
  triggered_by String?   @db.VarChar(50)
  error        String?
  created_at   DateTime  @default(now()) @db.Timestamp(6)
  processed_at DateTime? @db.Timestamp(6)

  company Company @relation(fields: [company_id], references: [id], onDelete: NoAction)

  @@index([company_id, status, queue_type])
  @@map("recalculation_queue")
  @@schema("auth")
}

model VATFiling {
  id                         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id                 String    @db.Uuid
  period_id                  String    @db.Uuid
  status                     String    @default("draft") @db.VarChar(20) // draft | filed | closed
  sales_standard_taxable     Decimal   @db.Decimal
  sales_standard_vat         Decimal   @db.Decimal
  sales_exempt               Decimal   @db.Decimal
  sales_zero_rated           Decimal   @db.Decimal
  purchases_standard_taxable Decimal   @db.Decimal
  purchases_standard_vat     Decimal   @db.Decimal
  reverse_charges            Decimal   @db.Decimal
  net_vat_amount             Decimal   @db.Decimal // output_vat - input_vat
  adjustment_amount          Decimal   @default(0) @db.Decimal
  carry_forward_applied      Decimal   @default(0) @db.Decimal
  total_vat_due              Decimal   @db.Decimal // net_vat_amount + adjustment_amount - carry_forward_applied
  filed_at                   DateTime? @db.Timestamp(6)
  filed_by                   String?   @db.Uuid
  created_at                 DateTime  @default(now()) @db.Timestamp(6)
  updated_at                 DateTime  @updatedAt @db.Timestamp(6)

  company Company @relation(fields: [company_id], references: [id], onDelete: NoAction)

  @@unique([company_id, period_id])
  @@map("vat_filings")
  @@schema("auth")
}

model VATAdjustment {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id      String   @db.Uuid
  period_id       String   @db.Uuid
  amount          Decimal  @db.Decimal
  reason          String
  adjustment_type String   @db.VarChar(50) // sales_correction | purchase_correction | bad_debt_relief | other
  created_by      String   @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamp(6)

  company Company @relation(fields: [company_id], references: [id], onDelete: NoAction)

  @@map("vat_adjustments")
  @@schema("auth")
}

model ZATCAConfiguration {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id              String    @db.Uuid
  zatca_env               String    @default("simulation") @db.VarChar(20)
  client_id_encrypted     String?   @db.Text
  client_secret_encrypted String?   @db.Text
  certificate_pem         String?   @db.Text
  private_key_encrypted   String?   @db.Text
  csid                    String?   @db.Text
  pcsid                   String?   @db.Text
  is_onboarded            Boolean   @default(false)
  cert_expiry             DateTime? @db.Timestamp(6)
  created_at              DateTime  @default(now()) @db.Timestamp(6)
  updated_at              DateTime  @updatedAt @db.Timestamp(6)

  company Company @relation(fields: [company_id], references: [id], onDelete: NoAction)

  @@unique([company_id])
  @@map("zatca_configurations")
  @@schema("auth")
}
