  labor_costs         Decimal  @default(0) @db.Decimal
  material_costs      Decimal  @default(0) @db.Decimal
  subcontractor_costs Decimal  @default(0) @db.Decimal
  overhead_allocation Decimal  @default(0) @db.Decimal
  gross_profit        Decimal  @default(0) @db.Decimal
  net_profit          Decimal  @default(0) @db.Decimal
