# ─── ZATCA e-Invoicing Configuration ─────────────────────────────────────────
#
# ZATCA_ENV controls the submission mode:
#   simulation  → Full queue lifecycle runs locally, invoices auto-ACCEPTED.
#                 No credentials required. Use for local development.
#   sandbox     → Submits to ZATCA Developer Portal sandbox.
#                 Requires ZATCA_CLIENT_ID + ZATCA_CLIENT_SECRET.
#   staging     → Submits to ZATCA Compliance CSID sandbox (pre-production).
#                 Requires full cert + key.
#   production  → Live ZATCA Fatoora production gateway.
#                 Requires all credentials below.
#
ZATCA_ENV=simulation

# ZATCA API Gateway URL
# sandbox:    https://gw-fatoora.zatca.gov.sa/e-invoicing/developer-portal
# staging:    https://gw-fatoora.zatca.gov.sa/e-invoicing/compliance
# production: https://gw-fatoora.zatca.gov.sa/e-invoicing/core
ZATCA_API_URL=

# OAuth credentials (sandbox/staging/production only)
ZATCA_CLIENT_ID=
ZATCA_CLIENT_SECRET=

# X.509 certificate (PEM, base64 encoded) — obtained after CSID onboarding
ZATCA_CERTIFICATE=

# RSA private key (PEM, base64 encoded) — used to sign invoice XML
ZATCA_PRIVATE_KEY=

# Company info used in QR code TLV encoding
# Must match your ZATCA registered company name exactly
ZATCA_SELLER_NAME=
# 15-digit Saudi VAT registration number
ZATCA_VAT_NUMBER=

# Queue configuration
# Max retry attempts before a submission is marked FAILED (dead-letter)
ZATCA_RETRY_LIMIT=3
# How often the submission worker polls for QUEUED jobs (in minutes)
ZATCA_WORKER_INTERVAL_MINUTES=2